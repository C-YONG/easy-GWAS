#!/bin/bash
# ═══════════════════════════════════════════════════════════════
# easy-GWAS — Two-tool GWAS (GCTA-LOCO + GEMMA-LMM)
#
# Usage:
#   easy-GWAS [--out DIR] [--trait N] single <VCF> <pheno.csv> <SNP|INDEL|SV>
#   easy-GWAS [--out DIR] [--trait N] batch  <snp.vcf> <indel.vcf> <sv.vcf> <pheno.csv>
#   easy-GWAS install
# ═══════════════════════════════════════════════════════════════
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Defaults
OUTDIR="./easy-gwas-out"
TRAIT_COL=1
MAF_SNP=0.05; GENO_SNP=0.05
MAF_INDEL=0.05; GENO_INDEL=0.05
MAF_SV=0.01; GENO_SV=0.20

# Parse flags (before command)
while [[ $# -gt 0 ]]; do
    case "$1" in
        --out) OUTDIR="$2"; shift 2;;
        --trait) TRAIT_COL="$2"; shift 2;;
        -h|--help) CMD=help; shift;;
        *) break;;
    esac
done

CMD="${1:-help}"
shift 2>/dev/null || true

# ── help / install (no tools needed) ──
if [ "$CMD" = "help" ] || [ "$CMD" = "-h" ] || [ "$CMD" = "--help" ]; then
    cat << 'HELP'
easy-GWAS — GWAS with GCTA-LOCO + GEMMA-LMM

Usage:
  easy-GWAS [--out DIR] [--trait N] single <VCF> <pheno.csv> <SNP|INDEL|SV>
  easy-GWAS [--out DIR] [--trait N] batch  <snp.vcf> <indel.vcf> <sv.vcf> <pheno.csv>
  easy-GWAS install

Options:
  --out DIR     Output directory (default: ./easy-gwas-out)
  --trait N     Trait column in CSV (0=FID, 1=first trait, default: 1)

Phenotype CSV: FID,trait1,trait2,... (header, NA=missing)

Output per type:
  gcta/gwas.loco.mlma     GCTA LOCO results (Chr, bp, p)
  gemma/*_gwas.assoc.txt  GEMMA LMM results (chr, ps, p_wald)
HELP
    exit 0
fi

if [ "$CMD" = "install" ]; then
    bash "$SCRIPT_DIR/install.sh"
    exit 0
fi

# ── find tools ──
find_tool() {
    for p in "$SCRIPT_DIR/bin/$1" "$(which "$1" 2>/dev/null)"; do
        if [ -x "$p" ]; then echo "$p"; return 0; fi
    done
    echo "ERROR: $1 not found. Run 'easy-GWAS install' first." >&2
    exit 1
}

export BCFTOOLS="${BCFTOOLS:-$(which bcftools 2>/dev/null || echo bcftools)}"
export PLINK="${PLINK:-$(which plink2 2>/dev/null || echo plink2)}"
GCTA=$(find_tool gcta64)
GEMMA=$(find_tool gemma)

# ── single ──
if [ "$CMD" = "single" ]; then
    bash "$SCRIPT_DIR/lib/run_gwas.sh" "$1" "$2" "$3" "$OUTDIR" "$TRAIT_COL" \
        "$GCTA" "$GEMMA" "$MAF_SNP" "$GENO_SNP" "$MAF_INDEL" "$GENO_INDEL" "$MAF_SV" "$GENO_SV"
    exit 0
fi

# ── batch ──
if [ "$CMD" = "batch" ]; then
    echo "═══ easy-GWAS batch ═══"
    echo "Output: $OUTDIR/{SNP,INDEL,SV}/"
    PHENO="$4"
    bash "$SCRIPT_DIR/lib/run_gwas.sh" "$1" "$PHENO" SNP   "$OUTDIR" "$TRAIT_COL" "$GCTA" "$GEMMA" "$MAF_SNP" "$GENO_SNP" "$MAF_INDEL" "$GENO_INDEL" "$MAF_SV" "$GENO_SV"
    bash "$SCRIPT_DIR/lib/run_gwas.sh" "$2" "$PHENO" INDEL "$OUTDIR" "$TRAIT_COL" "$GCTA" "$GEMMA" "$MAF_SNP" "$GENO_SNP" "$MAF_INDEL" "$GENO_INDEL" "$MAF_SV" "$GENO_SV"
    bash "$SCRIPT_DIR/lib/run_gwas.sh" "$3" "$PHENO" SV    "$OUTDIR" "$TRAIT_COL" "$GCTA" "$GEMMA" "$MAF_SNP" "$GENO_SNP" "$MAF_INDEL" "$GENO_INDEL" "$MAF_SV" "$GENO_SV"
    echo ""; echo "═══ GWAS complete ═══"
    echo "Results: $OUTDIR/{SNP,INDEL,SV}/gcta/gwas.loco.mlma"
    echo "         $OUTDIR/{SNP,INDEL,SV}/gemma/*_gwas.assoc.txt"
    exit 0
fi

echo "Unknown command: $CMD. Try 'easy-GWAS help'."
exit 1
