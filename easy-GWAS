#!/bin/bash
# ═══════════════════════════════════════════════════════════════
# easy-GWAS — GCTA-LOCO + GCTA-MLMA + GEMMA + LDAK-KVIK
# ═══════════════════════════════════════════════════════════════
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

OUTDIR="./easy-gwas-out"
TRAIT_COL=1; N_PCA=5; METHOD="all"; DO_GEC="0"; GEC=""
MAF_SNP=0.05; GENO_SNP=0.05
MAF_INDEL=0.05; GENO_INDEL=0.05
MAF_SV=0.01; GENO_SV=0.20

while [[ $# -gt 0 ]]; do
    case "$1" in
        --out) OUTDIR="$2"; shift 2;;
        --trait) TRAIT_COL="$2"; shift 2;;
        --pca) N_PCA="$2"; shift 2;;
        --method) METHOD="$2"; shift 2;;
        --gec) DO_GEC="1"; GEC="--gec"; shift;;
        -h|--help) CMD=help; shift;;
        *) break;;
    esac
done

CMD="${1:-help}"
shift 2>/dev/null || true

if [ "$CMD" = "help" ] || [ "$CMD" = "-h" ]; then
    cat << 'HELP'
easy-GWAS — GWAS + Plotting (GCTA-LOCO + GCTA-MLMA + GEMMA + LDAK-KVIK)

Commands:
  install                               Download GCTA + GEMMA + LDAK + GEC
  single  <VCF> <pheno.csv> <SNP|INDEL|SV>  Run GWAS
  batch   <snp.vcf> <indel.vcf> <sv.vcf> <pheno.csv>  All three types
  plot    <result> <prefix>                  Manhattan + QQ

Options:
  --out DIR     Output directory (default: ./easy-gwas-out)
  --trait N     Trait column (0=FID, 1=first trait, default: 1)
  --pca N       Number of PCs for LDAK-KVIK (default: 5, 0=skip KVIK)
  --method M    GWAS methods: all,loco,mlma,gemma,kvik (default: all)
  --gec         Use GEC-corrected thresholds (off by default)

Phenotype CSV: FID,trait1,... (header, NA=missing)
HELP
    exit 0
fi

if [ "$CMD" = "install" ]; then
    bash "$SCRIPT_DIR/install.sh"
    exit 0
fi

find_tool() {
    for p in "$SCRIPT_DIR/bin/$1" "$(which "$1" 2>/dev/null)"; do
        if [ -x "$p" ]; then echo "$p"; return 0; fi
    done
    return 1
}

export BCFTOOLS="${BCFTOOLS:-$(which bcftools 2>/dev/null || echo bcftools)}"
export PLINK="${PLINK:-$(which plink2 2>/dev/null || echo plink2)}"
GCTA=$(find_tool gcta64)
GEMMA=$(find_tool gemma)
LDAK=$(find_tool ldak6.2 2>/dev/null || echo "")

# ── auto_plot ──
auto_plot() {
    local type="$1" outdir="$2" trait_col="$3"
    local tdir="$outdir/$type"
    local prefix="${tdir}/${type}_trait${trait_col}"

    if ! command -v Rscript &>/dev/null; then
        echo "  (Rscript not found, skip plotting)"
        return
    fi

    echo ""
    echo "─── Auto-plotting $type ───"

    for entry in \
        "loco:$tdir/gcta/gwas_loco.loco.mlma:${prefix}_loco" \
        "mlma:$tdir/gcta/gwas_mlma.mlma:${prefix}_mlma" \
        "gemma:$tdir/gemma/${type}_gwas.assoc.txt:${prefix}_gemma" \
        "kvik:$tdir/ldak/${type}_kvik.step2.assoc:${prefix}_kvik"; do
        method="${entry%%:*}"
        rest="${entry#*:}"
        file="${rest%%:*}"
        pfx="${rest#*:}"
        if [ -f "$file" ]; then
            echo "  Plotting $method..."
            Rscript "$SCRIPT_DIR/lib/plot_gwas.R" "$file" "$pfx" $GEC 2>/dev/null && \
                echo "    -> ${pfx}_Manhattan.jpg + _QQ.jpg" || \
                echo "    Plot failed (R/CMplot may not be installed)"
        fi
    done
}

# ── single ──
if [ "$CMD" = "single" ]; then
    bash "$SCRIPT_DIR/lib/run_gwas.sh" "$1" "$2" "$3" "$OUTDIR" "$TRAIT_COL" \
        "$GCTA" "$GEMMA" "$LDAK" "$N_PCA" "$METHOD" "$DO_GEC" \
        "$MAF_SNP" "$GENO_SNP" "$MAF_INDEL" "$GENO_INDEL" "$MAF_SV" "$GENO_SV"
    auto_plot "$3" "$OUTDIR" "$TRAIT_COL"
    exit 0
fi

# ── batch ──
if [ "$CMD" = "batch" ]; then
    echo "═══ easy-GWAS batch ═══"
    PHENO="$4"
    for vtype in SNP INDEL SV; do
        case $vtype in
            SNP) vcf="$1" ;;
            INDEL) vcf="$2" ;;
            SV) vcf="$3" ;;
        esac
        bash "$SCRIPT_DIR/lib/run_gwas.sh" "$vcf" "$PHENO" "$vtype" "$OUTDIR" "$TRAIT_COL" \
            "$GCTA" "$GEMMA" "$LDAK" "$N_PCA" "$METHOD" "$DO_GEC" \
            "$MAF_SNP" "$GENO_SNP" "$MAF_INDEL" "$GENO_INDEL" "$MAF_SV" "$GENO_SV"
        auto_plot "$vtype" "$OUTDIR" "$TRAIT_COL"
    done
    echo ""; echo "═══ GWAS complete ═══"
    echo "Results: $OUTDIR/{SNP,INDEL,SV}/"
    exit 0
fi

# ── plot ──
PLOT_GEC=""; PLOT_FMT="jpg"
while [[ $# -gt 0 ]]; do
    case "$1" in
        --gec) PLOT_GEC="--gec"; shift;;
        --png) PLOT_FMT="png"; shift;;
        --format) PLOT_FMT="$2"; shift 2;;
        *) break;;
    esac
done

if [ "$CMD" = "plot" ]; then
    Rscript "$SCRIPT_DIR/lib/plot_gwas.R" "$1" "$2" $PLOT_GEC "--$PLOT_FMT"
    exit 0
fi

echo "Unknown command: $CMD. Try 'easy-GWAS help'."
exit 1
